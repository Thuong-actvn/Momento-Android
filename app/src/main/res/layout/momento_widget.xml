<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="0dp">

    <RelativeLayout
        android:id="@+id/widget_root"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:background="@drawable/widget_background">

        <ImageView
            android:id="@+id/widget_square"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:adjustViewBounds="true"
            android:importantForAccessibility="no"
            android:src="@drawable/widget_placeholder"
            android:visibility="invisible" />

        <ImageView
            android:id="@+id/widget_photo"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_alignTop="@id/widget_square"
            android:layout_alignBottom="@id/widget_square"
            android:importantForAccessibility="no"
            android:scaleType="centerCrop" />

        <ImageView
            android:id="@+id/widget_shade"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_alignTop="@id/widget_square"
            android:layout_alignBottom="@id/widget_square"
            android:importantForAccessibility="no"
            android:background="@drawable/widget_shade"
            android:visibility="gone" />

        <TextView
            android:id="@+id/widget_empty"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_alignTop="@id/widget_photo"
            android:layout_alignBottom="@id/widget_photo"
            android:fontFamily="@font/plusjakartasans_medium"
            android:gravity="center"
            android:padding="16dp"
            android:text="@string/widget_photo_empty"
            android:textColor="@color/widget_text"
            android:textSize="12sp"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/widget_footer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignBottom="@id/widget_photo"
            android:gravity="center_vertical"
            android:minHeight="40dp"
            android:orientation="horizontal"
            android:padding="8dp"
            android:visibility="gone">

            <ImageView
                android:id="@+id/widget_avatar"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:background="@drawable/widget_avatar_background"
                android:importantForAccessibility="no"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_avatar_placeholder" />

            <TextView
                android:id="@+id/widget_sender"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:autoSizeTextType="uniform"
                android:autoSizeMinTextSize="10sp"
                android:autoSizeMaxTextSize="12sp"
                android:autoSizeStepGranularity="1sp"
                android:ellipsize="end"
                android:fontFamily="@font/plusjakartasans_semibold"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textColor="@color/white"
                android:textSize="12sp" />

            <ImageButton
                android:id="@+id/widget_next_button"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:background="@android:color/transparent"
                android:contentDescription="@string/widget_next"
                android:padding="0dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_widget_next" />
        </LinearLayout>
    </RelativeLayout>
</FrameLayout>
